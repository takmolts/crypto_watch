# Discord の Incoming Webhook URL (通貨別チャンネル)
DISCORD_WEBHOOK_BTC=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
DISCORD_WEBHOOK_ETH=https://discord.com/api/webhooks/xxxxxxxx/zzzzzzzz
# 通貨別が無い場合のフォールバック
DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# ---- Discord bot (/crypto_status, /crypto_run) を使う場合だけ ----
# Developer Portal の Bot > Token。webhook とは別物
DISCORD_BOT_TOKEN=
# サーバーID。入れると slash コマンドが即時反映される (空だとグローバル同期で最大1時間)
DISCORD_GUILD_ID=

# ---- GitHub Pages に全文を公開する場合だけ ----
# 設定すると考察の全文・解析データ・推移をサイトに積み、Discord は要約 + リンクだけになる。
# 未設定なら従来どおり Discord に全文を送る
PAGES_URL=https://takmolts.github.io/crypto_watch/
# 何日分の考察を残すか (既定 7)
PAGES_KEEP_DAYS=7
# 作業コピーの場所 (既定 ~/.btc_oi_advisor/pages)、公開ブランチ (既定 gh-pages)、push 先 (既定 origin)
#PAGES_DIR=
#PAGES_BRANCH=gh-pages
#PAGES_REMOTE=git@github.com:takmolts/crypto_watch.git
